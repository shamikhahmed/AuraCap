{
  "name": "auracap",
  "private": true,
  "version": "5.5.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "extract-data": "node scripts/extract-from-html.mjs",
    "generate-icons": "node scripts/generate-icons.mjs",
    "test:unit": "node scripts/test-device-name.mjs",
    "test:e2e": "npm run build && playwright test",
    "gallery": "npm run build && CAPTURE_GALLERY=1 playwright test e2e/gallery.spec.ts",
    "gallery:v3": "node scripts/live-gallery-v3.mjs",
    "gallery:view": "python3 -m http.server 8772",
    "verify": "npm run lint && npm run test:unit && npm run test:e2e",
    "test:matrix": "npm run build && FINISH_MATRIX=1 playwright test e2e/finish-matrix.spec.ts",
    "ensure:version": "node -e \"const fs=require('fs'); const p='dist/VERSION.json'; if(!fs.existsSync(p)){console.error('AUR-V3-2: missing '+p); process.exit(1)} const v=JSON.parse(fs.readFileSync(p,'utf8')); if(!v.version||v.app!=='AuraCap'){console.error('AUR-V3-2: bad VERSION.json',v); process.exit(1)} console.log('VERSION.json ok', v.version);\"",
    "tier1": "node ../capricorn-tooling/shared/testing/tier1.mjs",
    "axe": "node scripts/capture-axe.mjs"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "idb": "^8.0.3",
    "lucide-react": "^1.17.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.17.0",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "sharp": "^0.35.0",
    "tailwindcss": "^4.3.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "vite-plugin-pwa": "^1.3.0"
  }
}
